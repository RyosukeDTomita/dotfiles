{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(play:*)",
      "Bash(serena:*)",
      "mcp__serena__check_onboarding_performed",
      "mcp__serena__list_dir",
      "mcp__serena__read_memory",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_symbol"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -f:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "play ~/dotfiles/junkbox/mp3/Chime.mp3"
          }
        ]
      }
    ]
  }
}
